{
  "name": "ais-source",
  "config": {
    "name": "ais-source",
    "connector.class": "net.rmoff.connect.ais.AisSourceConnector",

    "confluent.connector.type": "CUSTOM",
    "confluent.custom.plugin.id": "<ccp-XXXXXX from `confluent connect custom-plugin create`>",
    "confluent.custom.connection.endpoints": "153.44.253.27:5631:TCP;<psrc-XXXXXX>.<region>.<cloud>.confluent.cloud:443:TCP",

    "kafka.api.key": "<CC Kafka API key>",
    "kafka.api.secret": "<CC Kafka API secret>",

    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "io.confluent.connect.avro.AvroConverter",
    "value.converter.schema.registry.url": "https://<psrc-XXXXXX>.<region>.<cloud>.confluent.cloud",
    "value.converter.basic.auth.credentials.source": "USER_INFO",
    "value.converter.basic.auth.user.info": "<SR_KEY>:<SR_SECRET>",

    "topic": "ais",
    "ais.hosts": "153.44.253.27:5631",
    "tasks.max": "1"
  }
}
